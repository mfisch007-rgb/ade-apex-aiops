root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.py]
indent_size = 4
max_line_length = 88

[*.toml]
indent_size = 4

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 2

[*.jsonc]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab

[Dockerfile]
indent_size = 4

[*.sql]
indent_size = 4

[*.tf]
indent_size = 2

[*.ini]
indent_size = 4

[*.cfg]
indent_size = 4

[*.env]
indent_size = 2
